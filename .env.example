PORT=5000

# MongoDB connection string
# Docker Compose:  mongodb://mongo:27017/disaster-db
# Local dev:       mongodb://localhost:27017/disaster-db
# Atlas:           mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/disaster-db

# JWT — change this to a long random string in production
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer — Gmail with App Password (generate at myaccount.google.com → Security → App Passwords)
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Disaster Platform <your_gmail@gmail.com>"
# All notification emails go to this address in demo/dev mode
NOTIFY_TEST_EMAIL=your_test_inbox@gmail.com

# Predefined admin account — created by POST /api/auth/seed-admin
# Defaults if not set: admin@kdrp.in / Admin@2024
ADMIN_SEED_EMAIL=admin@kdrp.in
ADMIN_SEED_PASSWORD=Admin@2024
